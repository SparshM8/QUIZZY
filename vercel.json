{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/dist-bundle.cjs",
      "buildCommand": "npm run vercel:function-build",
      "functions": {
        "api/dist-bundle.cjs": {
          "runtime": "nodejs22.x",
          "maxDuration": 10
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}