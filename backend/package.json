{
  "name": "quizzy-backend",
  "version": "0.1.0",
  "description": "Quizzy — assessment platform backend (Node.js, Express, TypeScript, MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc -p tsconfig.api.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPattern=__tests__/unit --runInBand --forceExit",
    "test:integration": "jest --testPathPattern=__tests__/integration --runInBand --forceExit",
    "lint": "eslint src api --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@vercel/node": "^5.10.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
