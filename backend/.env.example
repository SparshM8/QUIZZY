# Environment Configuration
NODE_ENV=development
PORT=5000

# Database - Update with your MongoDB Atlas connection string
# Get free MongoDB Atlas database at: https://www.mongodb.com/atlas
# Replace with your actual connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Example: mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/myquizzydb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT - Change this to a secure random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional - for notifications)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password